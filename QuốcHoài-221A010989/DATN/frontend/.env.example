# ============================
# FRONTEND ENVIRONMENT VARIABLES — EXAMPLE
# Copy file này thành .env.local và điền giá trị thực
# Swift Coffee — Next.js Frontend
# ============================

# Backend API URL — phải bắt đầu bằng NEXT_PUBLIC_ để dùng ở phía client
# Đổi URL này khi deploy lên production
NEXT_PUBLIC_API_URL=http://localhost:5000/api
