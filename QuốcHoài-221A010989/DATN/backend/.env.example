# ============================
# BACKEND ENVIRONMENT VARIABLES — EXAMPLE
# Copy file này thành .env và điền giá trị thực
# Swift Coffee — Express.js API Server
# ============================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================
# DATABASE — MySQL
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swift_coffee_db
DB_USER=root
DB_PASS=your_mysql_password

# ============================
# JWT Authentication
# ============================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d

# ============================
# Email (Nodemailer)
# ============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Swift Coffee <noreply@swiftcoffee.vn>

# ============================
# PayOS Payment Gateway
# ============================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Payment Return URLs
PAYMENT_RETURN_URL=http://localhost:3000/payment-success
PAYMENT_CANCEL_URL=http://localhost:3000/payment-failed
